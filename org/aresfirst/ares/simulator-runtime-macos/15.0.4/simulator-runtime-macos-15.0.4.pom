  <modelVersion>4.0.0</modelVersion>
  <groupId>org.aresfirst.ares</groupId>
  <artifactId>simulator-runtime-macos</artifactId>
  <version>15.0.4</version>
  <name>ARES Robotics Library</name>
  <description>Shared Kotlin robotics, hardware, simulation, and code-generation libraries for ARES FIRST Robotics.</description>
  <url>https://github.com/ARES-23247/ARES-Robotics/tree/main/ARESLib-Kotlin</url>
  <inceptionYear>2024</inceptionYear>
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>ares-first</id>
      <name>ARES FIRST Robotics</name>
      <email>ares23247wv@gmail.com</email>
      <url>https://aresfirst.org</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/ARES-23247/ARES-Robotics.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/ARES-23247/ARES-Robotics.git</developerConnection>
    <url>https://github.com/ARES-23247/ARES-Robotics</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.aresfirst.ares</groupId>
      <artifactId>simulator</artifactId>
      <version>15.0.4</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>edu.wpi.first.wpinet</groupId>
      <artifactId>wpinet-jni</artifactId>
      <version>2024.3.2</version>
      <classifier>osxuniversal</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>edu.wpi.first.ntcore</groupId>
      <artifactId>ntcore-jni</artifactId>
      <version>2024.3.2</version>
      <classifier>osxuniversal</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>edu.wpi.first.wpiutil</groupId>
      <artifactId>wpiutil-jni</artifactId>
      <version>2024.3.2</version>
      <classifier>osxuniversal</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>edu.wpi.first.wpimath</groupId>
      <artifactId>wpimath-jni</artifactId>
      <version>2024.3.2</version>
      <classifier>osxuniversal</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>edu.wpi.first.hal</groupId>
      <artifactId>hal-jni</artifactId>
      <version>2024.3.2</version>
      <classifier>osxuniversal</classifier>

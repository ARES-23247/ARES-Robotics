{
  "schemaVersion": 2,
  "documentId": "driver",
  "revision": 1,
  "name": "BIOBUZZ drive, intake and shooter",
  "description": "Robot Builder-generated controls. A/J intake; B/L hive flywheel; X/U flower flywheel; RT/Shift feeds one ball per press. Dashboard Q/E operate red/blue human loaders.",
  "controllers": [
    {
      "slot": "driver",
      "displayName": "Driver",
      "profileId": "ftc-driver",
      "devicePort": 0
    }
  ],

          "outputMaximum": 1.0,
          "deadband": 0.05,
          "exponent": 1.0,
          "inverted": true
        },
        "thresholdDirection": "ABOVE",
        "zoneHysteresis": 0.0,
        "chordWindowSeconds": 0.075
      },
      "event": "VALUE",
      "target": {
        "kind": "DRIVE",
        "key": "vx",
        "arguments": {},

        "releaseDebounceSeconds": 0.0,
        "cooldownSeconds": 0.0
      },
      "analogPolicy": {
        "emitOnlyOnChange": false,
        "changeEpsilon": 1e-06,
        "rearmNeutralThreshold": 0.05,
        "valueArgumentKey": "value"
      },
      "priority": 0,

{
  "schemaVersion": 2,
  "documentId": "driver",
  "revision": 3,
  "name": "Field-centric driver controls",
  "description": "Alliance-wall field-centric controls: stick forward drives away from the driver wall (Red +Y, Blue -Y), and stick right drives toward the driver's right (Red +X, Blue -X). Right stick rotates CCW-positive. The sink applies alliance mirroring once.",
  "controllers": [
    {
      "slot": "driver",
      "displayName": "Driver",
      "profileId": "ftc-driver",
      "devicePort": 0
    }
  ],
  "bindings": [
    {
      "bindingId": "drive-forward",
      "displayName": "Drive forward/back",
      "source": {
        "kind": "AXIS_VALUE",
        "controllerSlot": "driver",
        "controlIds": ["left_stick_y"],
        "transform": {
          "inputMinimum": -1.0,
          "inputCenter": 0.0,
          "inputMaximum": 1.0,
          "outputMinimum": -1.0,
          "outputMaximum": 1.0,
          "deadband": 0.05,
          "exponent": 1.0,
          "inverted": true
        },
        "thresholdDirection": "ABOVE",
        "zoneHysteresis": 0.0,
        "chordWindowSeconds": 0.075
      },
      "event": "VALUE",
      "target": {
        "kind": "DRIVE",
        "key": "vy",
        "arguments": {},
        "routinePolicy": "IGNORE_IF_RUNNING"
      },
      "timing": {
        "pressDebounceSeconds": 0.0,
        "releaseDebounceSeconds": 0.0,
        "cooldownSeconds": 0.0
      },
      "analogPolicy": {
        "emitOnlyOnChange": false,
        "changeEpsilon": 1.0E-6,
        "rearmNeutralThreshold": 0.05,
        "valueArgumentKey": "value"
      },
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "drive-strafe",
      "displayName": "Strafe left/right",
      "source": {
        "kind": "AXIS_VALUE",
        "controllerSlot": "driver",
        "controlIds": ["left_stick_x"],
        "transform": {
          "inputMinimum": -1.0,
          "inputCenter": 0.0,
          "inputMaximum": 1.0,
          "outputMinimum": -1.0,
          "outputMaximum": 1.0,
          "deadband": 0.05,
          "exponent": 1.0,
          "inverted": false
        },
        "thresholdDirection": "ABOVE",
        "zoneHysteresis": 0.0,
        "chordWindowSeconds": 0.075
      },
      "event": "VALUE",
      "target": {
        "kind": "DRIVE",
        "key": "vx",
        "arguments": {},
        "routinePolicy": "IGNORE_IF_RUNNING"
      },
      "timing": {
        "pressDebounceSeconds": 0.0,
        "releaseDebounceSeconds": 0.0,
        "cooldownSeconds": 0.0
      },
      "analogPolicy": {
        "emitOnlyOnChange": false,
        "changeEpsilon": 1.0E-6,
        "rearmNeutralThreshold": 0.05,
        "valueArgumentKey": "value"
      },
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "drive-rotate",
      "displayName": "Rotate",
      "source": {
        "kind": "AXIS_VALUE",
        "controllerSlot": "driver",
        "controlIds": ["right_stick_x"],
        "transform": {
          "inputMinimum": -1.0,
          "inputCenter": 0.0,
          "inputMaximum": 1.0,
          "outputMinimum": -1.0,
          "outputMaximum": 1.0,
          "deadband": 0.05,
          "exponent": 1.0,
          "inverted": true
        },
        "thresholdDirection": "ABOVE",
        "zoneHysteresis": 0.0,
        "chordWindowSeconds": 0.075
      },
      "event": "VALUE",
      "target": {
        "kind": "DRIVE",
        "key": "omega",
        "arguments": {},
        "routinePolicy": "IGNORE_IF_RUNNING"
      },
      "timing": {
        "pressDebounceSeconds": 0.0,
        "releaseDebounceSeconds": 0.0,
        "cooldownSeconds": 0.0
      },
      "analogPolicy": {
        "emitOnlyOnChange": false,
        "changeEpsilon": 1.0E-6,
        "rearmNeutralThreshold": 0.05,
        "valueArgumentKey": "value"
      },
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "left-light-previous",
      "displayName": "Left indicator: previous color",
      "source": {"kind": "BUTTON", "controllerSlot": "driver", "controlIds": ["dpad_left"], "transform": null, "thresholdDirection": "ABOVE", "zoneHysteresis": 0.0, "chordWindowSeconds": 0.075},
      "event": "PRESS",
      "target": {"kind": "ACTION", "key": "subsystem.indicator-lights.cycleBackward.leftColor", "arguments": {}, "routinePolicy": "IGNORE_IF_RUNNING"},
      "timing": {"pressDebounceSeconds": 0.0, "releaseDebounceSeconds": 0.0, "cooldownSeconds": 0.0},
      "analogPolicy": null,
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "left-light-next",
      "displayName": "Left indicator: next color",
      "source": {"kind": "BUTTON", "controllerSlot": "driver", "controlIds": ["dpad_right"], "transform": null, "thresholdDirection": "ABOVE", "zoneHysteresis": 0.0, "chordWindowSeconds": 0.075},
      "event": "PRESS",
      "target": {"kind": "ACTION", "key": "subsystem.indicator-lights.cycleForward.leftColor", "arguments": {}, "routinePolicy": "IGNORE_IF_RUNNING"},
      "timing": {"pressDebounceSeconds": 0.0, "releaseDebounceSeconds": 0.0, "cooldownSeconds": 0.0},
      "analogPolicy": null,
      "priority": 0,
      "suppressConstituentBindings": false,

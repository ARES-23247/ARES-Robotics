    },
    {
      "bindingId": "right-light-previous",
      "displayName": "Right indicator: previous color",
      "source": {"kind": "BUTTON", "controllerSlot": "driver", "controlIds": ["dpad_down"], "transform": null, "thresholdDirection": "ABOVE", "zoneHysteresis": 0.0, "chordWindowSeconds": 0.075},
      "event": "PRESS",
      "target": {"kind": "ACTION", "key": "subsystem.indicator-lights.cycleBackward.rightColor", "arguments": {}, "routinePolicy": "IGNORE_IF_RUNNING"},
      "timing": {"pressDebounceSeconds": 0.0, "releaseDebounceSeconds": 0.0, "cooldownSeconds": 0.0},
      "analogPolicy": null,
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "right-light-next",
      "displayName": "Right indicator: next color",
      "source": {"kind": "BUTTON", "controllerSlot": "driver", "controlIds": ["dpad_up"], "transform": null, "thresholdDirection": "ABOVE", "zoneHysteresis": 0.0, "chordWindowSeconds": 0.075},
      "event": "PRESS",
      "target": {"kind": "ACTION", "key": "subsystem.indicator-lights.cycleForward.rightColor", "arguments": {}, "routinePolicy": "IGNORE_IF_RUNNING"},
      "timing": {"pressDebounceSeconds": 0.0, "releaseDebounceSeconds": 0.0, "cooldownSeconds": 0.0},
      "analogPolicy": null,
      "priority": 0,
      "suppressConstituentBindings": false,
      "enabled": true
    },
    {
      "bindingId": "recover-drive-neutral",
      "displayName": "Recover drive after a fault",
      "source": {
        "kind": "CHORD",
        "controllerSlot": "driver",
        "controlIds": ["back", "start"],
        "transform": null,
        "thresholdDirection": "ABOVE",
        "zoneHysteresis": 0.0,
        "chordWindowSeconds": 0.15
      },
      "event": "PRESS",
      "target": {
        "kind": "ACTION",
        "key": "drivetrain.recoverNeutral",
        "arguments": {},
        "routinePolicy": "IGNORE_IF_RUNNING"
      },
      "timing": {
        "pressDebounceSeconds": 0.1,
        "releaseDebounceSeconds": 0.1,
        "cooldownSeconds": 1.0
      },
      "analogPolicy": null,
      "priority": 100,
      "suppressConstituentBindings": true,
      "enabled": true
    }
  ]
}

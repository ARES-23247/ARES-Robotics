# All ARES-owned implementation is tracked by this source monorepo. The component directories
# retain isolated Gradle roots because Android, GradleRIO, Compose, and publishing toolchains have
# different constraints; they are no longer nested Git repositories.

# Workspace-local validation and package caches
/.tmp/
/.pnpm-store/
/.release-validation/
/.codex-validation/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
# Python bytecode is never a project source or release asset.
__pycache__/
*.py[cod]
/ARES-XRP-Starter/build/
/ARES-XRP-Starter/xrp_secrets.py

# Shared agent guidance is source, including when a developer has broad global ignores.
!AGENTS.md
!GEMINI.md
!/.agents/
!/.agents/skills/
!/.agents/skills/**/
!/.agents/skills/**
!/.agents/rules/
!/.agents/rules/**
# Agent sessions, credentials, caches, and local overrides are not shared guidance.
/.agents/tmp/
/.agents/cache/
/.agents/*.local.*
/.agents/skills/**/__pycache__/
/.agents/skills/**/*.py[cod]
/.gemini/settings.local.json
/.codex/config.local.toml

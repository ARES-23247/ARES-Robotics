# All ARES-owned implementation is tracked by this source monorepo. The component directories
# retain isolated Gradle roots because Android, GradleRIO, Compose, and publishing toolchains have
# different constraints; they are no longer nested Git repositories.

# Workspace-local validation and package caches
/.tmp/
/.pnpm-store/
/.release-validation/
/.codex-validation/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml
